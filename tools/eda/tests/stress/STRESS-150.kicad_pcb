		)
	)
	(gr_text "STRESS-150  rrkicad stress test   rev X   2026-11-25   RR-EL-TEST\n\nFABRICATION NOTES\n1. Material FR-4, Tg >= 150 C, 4 copper layers, finished thickness 1.60 mm +/-10 %.\n2. Outer copper 35 um (1 oz) finished; inner copper 17.5 um (0.5 oz).\n3. Min track / space 0.15 / 0.15 mm.  Min finished hole 0.30 mm.  Min annular ring 0.13 mm.\n4. Surface finish ENIG.  Solder mask both sides, vias tented.  Silkscreen both sides.\n5. Board outline per layer Edge.Cuts, tolerance +/-0.1 mm.  Outline 100.00 x 80.00 mm.\n6. Drill / pick-and-place origin = board origin, marked + on this drawing (Y axis up).\n7. Electrical test 100 % against the supplied Gerber netlist data.\n\nSTACKUP (top to bottom, mm)\n   F.Cu 0.035 (signal)\n   prepreg 0.2104\n   In1.Cu 0.0152 (plane)\n   core FR-4 1.0588\n   In2.Cu 0.0152 (plane)\n   prepreg 0.2104\n   B.Cu 0.035 (signal)\n\nHOLE TABLE (finished sizes, mm)\n   dia      type   qty   use\n   0.3      PTH    430   \n   0.4      PTH    6     \n   1.0      PTH    60    \n   1.3      PTH    2     \n   3.2      NPTH   4     mounting: H1 (4.00, 4.00), H2 (96.00, 4.00), H3 (4.00, 76.00), H4 (96.00, 76.00)\n   (436 of the plated holes are vias)"
		(at 166 53 0)
		(layer "Cmts.User")
		(uuid "c7fc518e-06cc-4ec2-8d0a-4432e1d6a997")
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.169)
			)
			(justify left top)
		)
	)
