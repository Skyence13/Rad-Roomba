(rule "chain_to_supply"
  (constraint clearance (min 1.00mm))
  (condition "A.NetClass == 'SAFETY_CHAIN' && (B.NetName == 'VBAT_RAW' || B.NetName == 'PSW_SRC' || B.NetName == 'VBAT_PROT' || B.NetName == 'VBAT_SW' || B.NetName == 'VSYS' || B.NetName == 'VMOT' || B.NetName == 'V12_AUX' || B.NetName == 'V12_LIDAR' || B.NetName == 'CHG_IN' || B.NetName == 'CHG_VIN' || B.NetName == 'HEAD_PWR_P' || B.NetName == 'HEAD_HTR_P' || B.NetName == 'CHS_HTR_P' || B.NetName == 'OUT1_L' || B.NetName == 'OUT2_L' || B.NetName == 'OUT1_R' || B.NetName == 'OUT2_R')"))
(rule "chain_tp_spacing"
  (constraint clearance (min 10.0mm))
  (condition "(A.memberOfFootprint('TP8') || A.memberOfFootprint('TP9') || A.memberOfFootprint('TP38') || A.memberOfFootprint('TP39') || A.memberOfFootprint('TP40') || A.memberOfFootprint('TP50') || A.memberOfFootprint('TP60') || A.memberOfFootprint('TP61') || A.memberOfFootprint('TP62')) && ((B.memberOfFootprint('TP8') || B.memberOfFootprint('TP9') || B.memberOfFootprint('TP38') || B.memberOfFootprint('TP39') || B.memberOfFootprint('TP40') || B.memberOfFootprint('TP50') || B.memberOfFootprint('TP60') || B.memberOfFootprint('TP61') || B.memberOfFootprint('TP62')) || (B.memberOfFootprint('TP41') || B.memberOfFootprint('TP42') || B.memberOfFootprint('TP47') || B.memberOfFootprint('TP59'))) && A.NetName != B.NetName"))
(rule "loop_to_heater"
  (constraint clearance (min 2.0mm))
  (condition "(A.NetName == 'LOOP_SRC' || A.NetName == 'LOOP_SNS' || A.NetName == 'LOOP_F' || A.NetName == 'LOOP_FB' || A.NetName == 'LOOP_VHI' || A.NetName == 'LOOP_VLO' || A.NetName == 'LOOP_VB' || A.NetName == 'HEAD_LOOP_OUT' || A.NetName == 'HEAD_LOOP_RET') && (B.NetName == 'HEAD_HTR_F' || B.NetName == 'HEAD_HTR_P' || B.NetName == 'HEAD_HTR_N' || B.NetName == 'CHS_HTR_F' || B.NetName == 'CHS_HTR_P')"))
