	(text "J1 pinout (JST GH 6-pin): 1 +3V3, 2 GND, 3 SDA, 4 SCL, 5 XSHUT, 6 GPIO1 (interrupt, open drain).\nD1 clamps all four signal lines at the connector. FB1 + C1/C2 filter the sensor supply.\nR1/R2 are series damping resistors; the I2C pull-ups live on the main board."
		(exclude_from_sim no)
		(at 20 26 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "292e386d-d44e-5837-8c9b-ae64067fac10")
	)
