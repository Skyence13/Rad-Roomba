	(gr_text "RR-TOF-A rev A"
		(at 59 98.6 0)
		(layer "F.SilkS")
		(uuid "820416cf-6e2c-4145-be27-64e6005db55e")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "RR-TOF-A  ToF sensor carrier (VL53L4ED)   rev A   2026-11-25   RR-EL-0101\n\nFABRICATION NOTES\n1. Material FR-4, Tg >= 150 C, 2 copper layers, finished thickness 1.60 mm +/-10 %.\n2. Outer copper 35 um (1 oz) finished.\n3. Min track / space 0.15 / 0.15 mm.  Min finished hole 0.30 mm.  Min annular ring 0.13 mm.\n4. Surface finish ENIG.  Solder mask both sides, vias tented.  Silkscreen both sides.\n5. Board outline per layer Edge.Cuts, tolerance +/-0.1 mm.  Outline 18.00 x 14.00 mm.\n6. Drill / pick-and-place origin = board origin, marked + on this drawing (Y axis up).\n7. Electrical test 100 % against the supplied Gerber netlist data.\n\nSTACKUP (top to bottom, mm)\n   F.Cu 0.035\n   core FR-4 1.510\n   B.Cu 0.035\n\nHOLE TABLE (finished sizes, mm)\n   dia      type   qty   use\n   0.3      PTH    18    \n   2.2      NPTH   2     mounting: H1 (-6.50, 0.00), H2 (6.50, 0.00)\n   (18 of the plated holes are vias)"
		(at 84 86.4 0)
		(layer "Cmts.User")
		(uuid "9d0577ed-6813-46f9-badd-0bbdbcdca2d9")
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.169)
			)
			(justify left top)
		)
	)
